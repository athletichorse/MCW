{%- comment -%}
MIM Find My Size v2 — interactive 3-step female fit finder.
Usage: {% render 'mim-size-finder', product: product %}
{%- endcomment -%}
{%- liquid
assign size_option = null
for option in product.options_with_values
assign oname = option.name | downcase | strip
if oname == 'size' or oname == 'sizes' or oname == 'taille' or oname == 'maat' or oname == 'المقاس' or oname == 'مقاس'
assign size_option = option
endif
endfor
assign recognized = 0
if size_option
for v in size_option.values
assign vu = v | upcase | strip
case vu
when 'XS', 'S', 'M', 'L', 'XL', 'XXL', '2XL', 'XXXL', '3XL', '4XL', 'XXXXL', '1', '2', '3', '4'
assign recognized = recognized | plus: 1
endcase
endfor
endif
assign haystack = product.title | append: ' ' | append: product.type | downcase
assign garment = 'top'
if haystack contains 'dress' or haystack contains 'jumpsuit' or haystack contains 'abaya' or haystack contains 'kaftan'
assign garment = 'dress'
elsif haystack contains 'pant' or haystack contains 'legging' or haystack contains 'jupe' or haystack contains 'skirt' or haystack contains 'trouser' or haystack contains 'short'
assign garment = 'bottom'
endif
assign uid = product.id
-%}
{%- liquid
assign sf_mode = 'sized'
unless size_option and recognized >= 2
assign sf_mode = 'guide'
endunless
assign sf_opt_name = ''
assign sf_opt_label = 'Size'
if sf_mode == 'sized'
assign sf_opt_name = size_option.name
assign sf_opt_label = size_option.name
endif
assign g_lc = request.locale.iso_code
case g_lc
when 'ar'
assign g_select = 'تم، مقاسك [size]'
assign g_selected = 'مقاسك المعتاد [size]، وهذه القطعة تناسبك'
assign g_note = 'هذه القطعة بمقاس واحد وقصة مريحة، فهي تناسب مقاسك. المقاس الظاهر هو مقاسك المعتاد للمرجع فقط.'
when 'fr'
assign g_select = 'Terminé, votre taille [size]'
assign g_selected = 'Votre taille habituelle : [size]. Cette pièce vous va'
assign g_note = 'Cette pièce est en taille unique, coupe ample : elle vous va. La taille affichée est votre taille habituelle, à titre indicatif.'
when 'nl'
assign g_select = 'Klaar, jouw maat [size]'
assign g_selected = 'Jouw gewone maat: [size]. Dit stuk past je'
assign g_note = 'Dit stuk is one size met een ruime pasvorm, dus het past je. De getoonde maat is je gebruikelijke maat, ter referentie.'
else
assign g_select = 'Done, your size is [size]'
assign g_selected = 'Your usual size: [size]. This piece fits you'
assign g_note = 'This piece is one size with a relaxed cut, so it fits you. The size shown is your usual size, for reference.'
endcase
-%}
{%- comment -%} v3.9.1 rule: the finder only shows when the product has real sizes to choose between (XS–3XL or 1–4). Free size, one size or no size option = no finder. {%- endcomment -%}
{%- if sf_mode == 'sized' -%}
{{ 'mim-size-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mim-size-finder.js' | asset_url }}" defer="defer"></script>
<mim-size-finder class="mim-sf" data-option-name="{{ sf_opt_name | escape }}" data-mode="{{ sf_mode }}" data-garment="{{ garment }}">
<script type="application/json" data-mim-sizes>{%- if sf_mode == 'sized' -%}{{ size_option.values | json }}{%- else -%}["XS","S","M","L","XL","XXL"]{%- endif -%}</script>
<script type="application/json" data-mim-i18n>
{
"your_size": {{ 'mim.sf.your_size' | t | json }},
"match": {{ 'mim.sf.match' | t | json }},
"confident": {{ 'mim.sf.confident' | t | json }},
"close_match": {{ 'mim.sf.close_match' | t | json }},
"note_true": {%- if sf_mode == 'sized' -%}{{ 'mim.sf.note_true' | t | json }}{%- else -%}{{ g_note | json }}{%- endif -%},
"note_between_up": {%- if sf_mode == 'sized' -%}{{ 'mim.sf.note_between_up' | t | json }}{%- else -%}{{ g_note | json }}{%- endif -%},
"note_between_down": {%- if sf_mode == 'sized' -%}{{ 'mim.sf.note_between_down' | t | json }}{%- else -%}{{ g_note | json }}{%- endif -%},
"note_unavail": {%- if sf_mode == 'sized' -%}{{ 'mim.sf.note_unavail' | t | json }}{%- else -%}{{ g_note | json }}{%- endif -%},
"select_size": {%- if sf_mode == 'sized' -%}{{ 'mim.sf.select_size' | t | json }}{%- else -%}{{ g_select | json }}{%- endif -%},
"selected": {%- if sf_mode == 'sized' -%}{{ 'mim.sf.selected' | t | json }}{%- else -%}{{ g_selected | json }}{%- endif -%},
"see_result": {{ 'mim.sf.see_result' | t | json }},
"continue": {{ 'mim.sf.continue' | t | json }}
}
</script>
<button type="button" class="mim-sf__trigger" data-mim-open aria-haspopup="dialog">
<span class="mim-sf__trigger-icon" aria-hidden="true">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2.5" y="7.5" width="19" height="9" rx="2"/><path d="M6.5 7.5v3M10 7.5v4.5M13.5 7.5v3M17 7.5v4.5"/></svg>
</span>
<span class="mim-sf__trigger-text">
<span class="mim-sf__trigger-label" data-mim-trigger-label>
<b>{{ 'mim.sf.find_my_size' | t }}</b>
<small>{{ 'mim.sf.teaser' | t }}</small>
</span>
<span class="mim-sf__trigger-result" data-mim-trigger-result hidden></span>
</span>
<span class="mim-sf__trigger-arrow" aria-hidden="true">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
</span>
</button>
<div class="mim-sf__overlay" data-mim-overlay hidden></div>
<div class="mim-sf__panel mim-sf-root" role="dialog" aria-modal="true" aria-labelledby="MimSfTitle-{{ uid }}" data-mim-panel data-step="1" hidden>
<div class="mim-sf__grab" aria-hidden="true"></div>
<div class="mim-sf__head">
<p class="mim-sf__eyebrow" id="MimSfTitle-{{ uid }}">{{ 'mim.sf.title' | t }}</p>
<button type="button" class="mim-sf__close" data-mim-close aria-label="{{ 'mim.sf.close' | t }}">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
</button>
</div>
<div class="mim-sf__product">
{%- if product.featured_image -%}
<img src="{{ product.featured_image | image_url: width: 160 }}" alt="" width="48" height="60" loading="lazy" class="mim-sf__product-img">
{%- endif -%}
<div>
<p class="mim-sf__product-title">{{ product.title }}</p>
<p class="mim-sf__product-price">{{ product.price | money }}</p>
</div>
</div>
<div class="mim-sf__progress" aria-hidden="true"><span data-mim-bar="1"></span><span data-mim-bar="2"></span><span data-mim-bar="3"></span></div>
<div class="mim-sf__body">
<section class="mim-sf__step" data-mim-step="1">
<p class="mim-sf__count">01 / 03</p>
<h2 class="mim-sf__title">{{ 'mim.sf.s1_title' | t }}</h2>
<p class="mim-sf__sub">{{ 'mim.sf.s1_sub' | t }}</p>
<div class="mim-sf__measure-wrap">
<div class="mim-sf__figure" aria-hidden="true">
<svg viewBox="0 0 60 170" width="64" height="180">
<line x1="0" y1="4" x2="60" y2="4" stroke="currentColor" stroke-dasharray="2 3" opacity=".45"/>
<g data-mim-body fill="currentColor" class="mim-sf__body-shape">
<circle cx="30" cy="15" r="8.5"/>
<rect x="27" y="22" width="6" height="8" rx="2"/>
<path d="M21 28h18c4 0 7 3 8 7l5 23c1 3-3 4-4 1l-5-19-1 13c6 9 9 20 9 32h-7l-3 81h-7l-3-60-3 60h-7l-3-81h-7c0-12 3-23 9-32l-1-13-5 19c-1 3-5 2-4-1l5-23c1-4 4-7 8-7z"/>
</g>
</svg>
</div>
<div class="mim-sf__measures">
<div class="mim-sf__measure">
<div class="mim-sf__measure-head">
<span class="mim-sf__label">{{ 'mim.sf.height' | t }}</span>
<span class="mim-sf__units" role="group">
<button type="button" class="is-active" data-mim-unit-h="cm">{{ 'mim.sf.cm' | t }}</button>
<button type="button" data-mim-unit-h="in">{{ 'mim.sf.ftin' | t }}</button>
</span>
</div>
<output class="mim-sf__value" data-mim-height-out>165</output>
<div class="mim-sf__range">
<button type="button" class="mim-sf__step-btn" data-mim-nudge="height" data-dir="-1" aria-label="−">−</button>
<input type="range" min="140" max="200" step="1" value="165" data-mim-height aria-label="{{ 'mim.sf.height' | t }}">
<button type="button" class="mim-sf__step-btn" data-mim-nudge="height" data-dir="1" aria-label="+">+</button>
</div>
</div>
<div class="mim-sf__measure">
<div class="mim-sf__measure-head">
<span class="mim-sf__label">{{ 'mim.sf.weight' | t }}</span>
<span class="mim-sf__units" role="group">
<button type="button" class="is-active" data-mim-unit-w="kg">{{ 'mim.sf.kg' | t }}</button>
<button type="button" data-mim-unit-w="lb">{{ 'mim.sf.lbs' | t }}</button>
</span>
</div>
<output class="mim-sf__value" data-mim-weight-out>62</output>
<div class="mim-sf__range">
<button type="button" class="mim-sf__step-btn" data-mim-nudge="weight" data-dir="-1" aria-label="−">−</button>
<input type="range" min="38" max="150" step="1" value="62" data-mim-weight aria-label="{{ 'mim.sf.weight' | t }}">
<button type="button" class="mim-sf__step-btn" data-mim-nudge="weight" data-dir="1" aria-label="+">+</button>
</div>
</div>
</div>
</div>
<p class="mim-sf__privacy">
<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
{{ 'mim.sf.privacy' | t }}
</p>
</section>
<section class="mim-sf__step" data-mim-step="2" hidden>
<p class="mim-sf__count">02 / 03</p>
<h2 class="mim-sf__title">{{ 'mim.sf.s2_title' | t }}</h2>
<p class="mim-sf__sub">{{ 'mim.sf.s2_sub' | t }}</p>
<fieldset class="mim-sf__shape">
<legend class="mim-sf__label">{{ 'mim.sf.bust' | t }}</legend>
<div class="mim-sf__choices">
<label><input type="radio" name="mim-bust" value="-1"><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M13 8c0 8-2 10-2 16s4 7 9 7 9-1 9-7-2-8-2-16"/></svg>{{ 'mim.sf.smaller' | t }}</span></label>
<label><input type="radio" name="mim-bust" value="0" checked><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M13 8c0 7-4 9-4 15s5 8 11 8 11-2 11-8-4-8-4-15"/></svg>{{ 'mim.sf.average' | t }}</span></label>
<label><input type="radio" name="mim-bust" value="1"><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M13 8c0 6-7 8-7 15s7 8 14 8 14-1 14-8-7-9-7-15"/></svg>{{ 'mim.sf.fuller' | t }}</span></label>
</div>
</fieldset>
<fieldset class="mim-sf__shape">
<legend class="mim-sf__label">{{ 'mim.sf.stomach' | t }}</legend>
<div class="mim-sf__choices">
<label><input type="radio" name="mim-stomach" value="-1"><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M15 6v28M25 6v28"/></svg>{{ 'mim.sf.flatter' | t }}</span></label>
<label><input type="radio" name="mim-stomach" value="0" checked><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M15 6v28M25 6c4 6 4 22 0 28"/></svg>{{ 'mim.sf.average' | t }}</span></label>
<label><input type="radio" name="mim-stomach" value="1"><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M15 6v28M25 6c9 6 9 22 0 28"/></svg>{{ 'mim.sf.rounder' | t }}</span></label>
</div>
</fieldset>
<fieldset class="mim-sf__shape">
<legend class="mim-sf__label">{{ 'mim.sf.hips' | t }}</legend>
<div class="mim-sf__choices">
<label><input type="radio" name="mim-hips" value="-1"><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M15 6c-2 9 2 13 0 28M25 6c2 9-2 13 0 28"/></svg>{{ 'mim.sf.narrower' | t }}</span></label>
<label><input type="radio" name="mim-hips" value="0" checked><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M16 6c-5 10 2 14 0 28M24 6c5 10-2 14 0 28"/></svg>{{ 'mim.sf.average' | t }}</span></label>
<label><input type="radio" name="mim-hips" value="1"><span><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M17 6c-9 11 0 15-2 28M23 6c9 11 0 15 2 28"/></svg>{{ 'mim.sf.curvier' | t }}</span></label>
</div>
</fieldset>
</section>
<section class="mim-sf__step" data-mim-step="3" hidden>
<p class="mim-sf__count">03 / 03</p>
<h2 class="mim-sf__title">{{ 'mim.sf.s3_title' | t }}</h2>
<p class="mim-sf__sub">{{ 'mim.sf.s3_sub' | t }}</p>
<div class="mim-sf__fits" role="radiogroup">
<label class="mim-sf__fit"><input type="radio" name="mim-fit" value="-1"><span><i class="mim-sf__fit-ico mim-sf__fit-ico--fitted" aria-hidden="true"></i><strong>{{ 'mim.sf.fit_fitted' | t }}</strong><em>{{ 'mim.sf.fit_fitted_d' | t }}</em></span></label>
<label class="mim-sf__fit"><input type="radio" name="mim-fit" value="0" checked><span><i class="mim-sf__fit-ico" aria-hidden="true"></i><strong>{{ 'mim.sf.fit_regular' | t }}</strong><em>{{ 'mim.sf.fit_regular_d' | t }}</em></span></label>
<label class="mim-sf__fit"><input type="radio" name="mim-fit" value="1"><span><i class="mim-sf__fit-ico mim-sf__fit-ico--relaxed" aria-hidden="true"></i><strong>{{ 'mim.sf.fit_relaxed' | t }}</strong><em>{{ 'mim.sf.fit_relaxed_d' | t }}</em></span></label>
</div>
</section>
<section class="mim-sf__step mim-sf__result" data-mim-step="4" hidden>
<p class="mim-sf__label mim-sf__center">{{ 'mim.sf.best_match' | t }}</p>
<div class="mim-sf__ring">
<svg viewBox="0 0 120 120" aria-hidden="true">
<circle cx="60" cy="60" r="54" class="mim-sf__ring-track"/>
<circle cx="60" cy="60" r="54" class="mim-sf__ring-fill" data-mim-ring/>
</svg>
<span data-mim-result-size>M</span>
</div>
<p class="mim-sf__match"><span data-mim-match>0%</span> <span class="mim-sf__label">{{ 'mim.sf.fit_match' | t }}</span></p>
<p class="mim-sf__muted mim-sf__center" data-mim-confidence></p>
<div class="mim-sf__chips" data-mim-chips role="group" aria-label="{{ sf_opt_label | escape }}"></div>
<p class="mim-sf__muted mim-sf__center mim-sf__small">{{ 'mim.sf.tap_size' | t }}</p>
<div class="mim-sf__bars">
<div class="mim-sf__bars-head"><span></span><span>{{ 'mim.sf.snug' | t }}</span><span>{{ 'mim.sf.ideal' | t }}</span><span>{{ 'mim.sf.roomy' | t }}</span></div>
<div class="mim-sf__bar" data-mim-row="bust"><span class="mim-sf__label">{{ 'mim.sf.bust' | t }}</span><span class="mim-sf__track"><i data-mim-dot></i></span></div>
<div class="mim-sf__bar" data-mim-row="waist"><span class="mim-sf__label">{{ 'mim.sf.waist' | t }}</span><span class="mim-sf__track"><i data-mim-dot></i></span></div>
<div class="mim-sf__bar" data-mim-row="hips"><span class="mim-sf__label">{{ 'mim.sf.hips' | t }}</span><span class="mim-sf__track"><i data-mim-dot></i></span></div>
<div class="mim-sf__bars-head mim-sf__bars-head--length"><span></span><span>{{ 'mim.sf.shorter' | t }}</span><span>{{ 'mim.sf.ideal' | t }}</span><span>{{ 'mim.sf.longer' | t }}</span></div>
<div class="mim-sf__bar" data-mim-row="length"><span class="mim-sf__label">{{ 'mim.sf.length' | t }}</span><span class="mim-sf__track"><i data-mim-dot></i></span></div>
</div>
<div class="mim-sf__note">
<p class="mim-sf__label">{{ 'mim.sf.fit_note' | t }}</p>
<p data-mim-note></p>
</div>
<p class="mim-sf__disclaimer">{{ 'mim.sf.disclaimer' | t }}</p>
<button type="button" class="mim-sf__restart" data-mim-restart hidden>{{ 'mim.sf.start_over' | t }}</button>
</section>
</div>
<div class="mim-sf__live" aria-live="polite">
<span class="mim-sf__live-label">{{ 'mim.sf.live_estimate' | t }}</span>
<span class="mim-sf__live-chips" data-mim-live-chips></span>
<b class="mim-sf__live-size" data-mim-live>M</b>
</div>
<div class="mim-sf__foot">
<button type="button" class="mim-sf__back" data-mim-back aria-label="{{ 'mim.sf.back' | t }}">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
</button>
<button type="button" class="mim-sf__next" data-mim-next>
<span data-mim-next-label>{{ 'mim.sf.continue' | t }}</span>
<svg class="mim-sf__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
</button>
</div>
</div>
</mim-size-finder>
{%- endif -%}
{%- liquid
assign is_free = false
if size_option
for v in size_option.values
assign vd = v | downcase
if vd contains 'free' or vd contains 'one size'
assign is_free = true
endif
endfor
endif
assign tl = product.title | downcase
if tl contains 'free size'
assign is_free = true
endif
assign lc = request.locale.iso_code
case lc
when 'ar'
assign f_t = 'مقاس حر، يناسب الجميع'
assign f_d = 'قصّة واسعة تناسب تقريبًا المقاسات من XS إلى XXL (الصدر حتى 120 سم تقريبًا).'
assign f_c = 'غير متأكدة؟ راسلينا على واتساب'
when 'fr'
assign f_t = 'Taille unique, pensée pour toutes'
assign f_d = 'Coupe ample qui convient environ du XS au XXL (tour de poitrine jusqu’à 120 cm environ).'
assign f_c = 'Un doute ? Écrivez-nous sur WhatsApp'
when 'nl'
assign f_t = 'Vrije maat, voor iedereen'
assign f_d = 'Ruime pasvorm die ongeveer past van XS tot XXL (borstomvang tot circa 120 cm).'
assign f_c = 'Twijfel je? Stuur ons een WhatsApp'
else
assign f_t = 'Free size, made to fit most'
assign f_d = 'A relaxed cut that fits roughly XS to XXL (bust up to about 120 cm).'
assign f_c = 'Not sure? Ask us on WhatsApp'
endcase
-%}
{%- if is_free -%}
<div class="mim-sf-free">
<span class="mim-sf-free__ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 3l-5 3 2 5 3-1v11h8V10l3 1 2-5-5-3c-1 2-2.5 3-4 3S9 5 8 3z"/></svg></span>
<span class="mim-sf-free__txt"><b>{{ f_t }}</b><small>{{ f_d }}</small><a href="https://wa.me/201222116237?text={{ product.title | url_encode }}" target="_blank" rel="noopener">{{ f_c }}</a></span>
</div>
<style>.mim-sf-free{display:flex;gap:1.2rem;align-items:flex-start;margin:1.2rem 0 .4rem;padding:1.4rem 1.6rem;border:1px solid rgba(20,39,43,.14);border-radius:1.6rem;background:#F3ECE2;color:#14272B}.mim-sf-free__ico{flex:none;display:grid;place-items:center;width:4rem;height:4rem;border-radius:50%;background:#fff;color:#0B5C64}.mim-sf-free__txt{display:flex;flex-direction:column;gap:.3rem;font-size:1.35rem;line-height:1.5}.mim-sf-free__txt b{font-size:1.5rem}.mim-sf-free__txt small{font-size:1.3rem;opacity:.8}.mim-sf-free__txt a{color:#0B5C64;font-weight:500;text-decoration:underline;text-underline-offset:.25em}</style>
{%- endif -%}
