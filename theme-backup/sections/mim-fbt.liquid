{%- comment -%} Bought together: the best match from each of the first two complementary categories (see mim-xsell). {%- endcomment -%}
{%- liquid
capture picks
render 'mim-xsell', product: product, limit: 2, per_type: 1
endcapture
assign pairs = picks | strip | split: ','
-%}
{%- if product.available and pairs.size > 0 -%}
<section class="mim-fbt page-width mim-r" data-mim-fbt>
<h2 class="mim-fbt__title">{{ 'mim.fbt.heading' | t }}</h2>
<div class="mim-fbt__wrap">
<ul class="mim-fbt__list">
{%- for n in (0..2) -%}
{%- liquid
if n == 0
assign p = product
else
assign idx = n | minus: 1
assign pair = pairs[idx] | split: ':'
assign pi = pair[1] | plus: 0
assign p = collections[pair[0]].products[pi]
endif
-%}
{%- if p -%}
{%- assign v = p.selected_or_first_available_variant -%}
<li class="mim-fbt__item" data-fbt-item>
<label class="mim-fbt__check">
<input type="checkbox" checked data-fbt-check{% if n == 0 %} data-fbt-main{% endif %}>
<span aria-hidden="true"></span>
</label>
<a class="mim-fbt__img" href="{{ p.url }}">
{%- if p.featured_media -%}{%- assign fbt_alt = p.featured_media.alt | default: p.title -%}{{ p.featured_media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px', alt: fbt_alt }}{%- endif -%}
</a>
<div class="mim-fbt__info">
{%- if n == 0 -%}<small class="mim-fbt__this">{{ 'mim.fbt.this' | t }}</small>{%- endif -%}
<a class="mim-fbt__name" href="{{ p.url }}">{% render 'mim-title', title: p.title %}</a>
{%- if p.has_only_default_variant -%}
<input type="hidden" data-fbt-variant value="{{ v.id }}" data-price="{{ v.price }}">
{%- else -%}
<select class="mim-fbt__select" data-fbt-variant aria-label="{{ p.title | escape }}">
{%- for pv in p.variants -%}
{%- if pv.available -%}<option value="{{ pv.id }}" data-price="{{ pv.price }}"{% if pv.id == v.id %} selected{% endif %}>{%- for o in pv.options -%}{% render 'mim-tr', text: o %}{%- unless forloop.last %} / {% endunless -%}{%- endfor -%}</option>{%- endif -%}
{%- endfor -%}
</select>
{%- endif -%}
<span class="mim-fbt__price" data-fbt-price>
{%- if v.compare_at_price > v.price -%}<span class="mim-price-sale">{{ v.price | money_without_trailing_zeros }}</span> <s class="mim-price-old">{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- else -%}{{ v.price | money_without_trailing_zeros }}{%- endif -%}
</span>
</div>
</li>
{%- endif -%}
{%- endfor -%}
</ul>
<div class="mim-fbt__total">
<p>{{ 'mim.fbt.total' | t }} <b data-fbt-total>—</b></p>
<button type="button" class="mim-btn mim-btn--solid" data-fbt-add>{{ 'mim.fbt.add' | t }}</button>
<p class="mim-fbt__msg" data-fbt-msg role="status" aria-live="polite"></p>
</div>
</div>
<script type="application/json" data-fbt-i18n>{"added": {{ 'mim.fbt.added' | t | json }}, "error": {{ 'mim.fbt.error' | t | json }}, "money": {{ shop.money_format | strip_html | json }}}</script>
</section>
{%- endif -%}
{% schema %}
{
"name": "MIM Bought together",
"tag": "div",
"class": "section mim-section",
"enabled_on": { "templates": ["product"] },
"settings": [],
"presets": [{ "name": "MIM Bought together" }]
}
{% endschema %}