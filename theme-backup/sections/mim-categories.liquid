{%- liquid
assign kb = 'mim.home.cats.'
assign t_eyebrow = section.settings.eyebrow
if t_eyebrow == blank
assign k = kb | append: 'eyebrow'
assign t_eyebrow = k | t
endif
assign t_heading = section.settings.heading
if t_heading == blank
assign k = kb | append: 'heading_html'
assign t_heading = k | t
endif
assign t_link = section.settings.link_label
if t_link == blank
assign k = kb | append: 'link_label'
assign t_link = k | t
endif
-%}
<section class="mim-cats mim-railsec" data-mim-rail>
<div class="page-width">
<div class="mim-head mim-r">
<div>
<p class="mim-eyebrow">{{ t_eyebrow }}</p>
<h2 class="mim-h2">{{ t_heading }}</h2>
</div>
<div style="display:flex;gap:1.6rem;align-items:center">
<a class="mim-link" href="{{ routes.collections_url }}">{{ t_link }} <span aria-hidden="true">→</span></a>
<div class="mim-rail__arrows" data-rail-arrows>
<button type="button" class="mim-rail__btn" data-rail-prev aria-label="{{ 'mim.ui.prev' | t }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg></button>
<button type="button" class="mim-rail__btn" data-rail-next aria-label="{{ 'mim.ui.next' | t }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
</div>
</div>
</div>
</div>
<div class="mim-cats__rail" data-rail-track>
{%- for block in section.blocks -%}
{%- liquid
assign c = block.settings.collection
assign img = block.settings.image
if img == blank and c != blank
assign img = c.products[0].featured_media.preview_image
if img == blank
assign img = c.image
endif
endif
assign title = block.settings.title
if title == blank and c != blank
assign title = c.title
endif
-%}
<a class="mim-cats__card mim-r" style="--d: {{ forloop.index0 }}" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
{%- if img != blank -%}
{%- assign cat_alt = title -%}
{{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 450, 600, 700', sizes: '(min-width: 990px) 20vw, 60vw', alt: cat_alt }}
{%- endif -%}
<span class="mim-cats__meta">
<span><span class="mim-cats__title">{{ title }}</span>{%- if c != blank -%}<span class="mim-cats__count">{{ c.products_count }} {{ 'mim.ui.pieces' | t }}</span>{%- endif -%}</span>
<span class="mim-cats__go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
</span>
</a>
{%- endfor -%}
</div>
</section>
<style>
.mim-cats__card .mim-cats__go svg{position:static;inset:auto;width:1.8rem;height:1.8rem;transition:none}
@media (hover:none){.mim-cats__card:hover img{transform:none}.mim-cats__card:hover .mim-cats__go{transform:none;background:#fff}}
</style>
{% schema %}
{
"name": "MIM Categories",
"tag": "div",
"class": "section mim-section",
"settings": [
{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank to use the built-in English/Arabic text." },
{ "type": "text", "id": "heading", "label": "Heading" },
{ "type": "text", "id": "link_label", "label": "Link label" }
],
"blocks": [
{ "type": "category", "name": "Category", "settings": [
{ "type": "collection", "id": "collection", "label": "Collection" },
{ "type": "text", "id": "title", "label": "Title override" },
{ "type": "image_picker", "id": "image", "label": "Image override" }
] }
],
"presets": [{ "name": "MIM Categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}