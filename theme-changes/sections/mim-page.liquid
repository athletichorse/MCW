      assign l_more = 'كل الأسئلة'
      assign l_still = 'عندك سؤال آخر؟'
      assign l_still_t = 'نرد عادةً خلال ساعات قليلة. واتساب هو الأسرع.'
      assign l_wa = 'راسلينا على واتساب'
      assign l_mail = 'أرسلي بريدًا'
      assign l_chap = 'في هذه الصفحة'
      assign q1 = 'التوصيل في مصر'
      assign a1 = 'القاهرة والجيزة 85 · الإسكندرية 120 · باقي المحافظات 150 جنيه (2–5 أيام). السريع للقاهرة والجيزة فقط'
      assign q2 = 'توصيل مجاني'
      assign a2 = 'للطلبات فوق 2,999 جنيه · يسري على القاهرة والجيزة'
      assign q3 = 'الشحن الدولي'
