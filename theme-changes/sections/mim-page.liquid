      assign q4 = 'الاستبدال'
      assign a4 = 'القطع غير الملبوسة خلال يومين من الاستلام'
      assign q5 = 'الدفع'
      assign a5 = 'الدفع عند الاستلام أو بالبطاقة'
    when 'fr'
      assign l_search = 'Rechercher une question…'
      assign l_none = 'Aucune question ne correspond. Écrivez-nous sur WhatsApp, nous répondons vite.'
      assign l_quick = 'Réponses rapides'
      assign l_more = 'Toutes les questions'
      assign l_still = 'Une autre question ?'
      assign l_still_t = 'Nous répondons en général en quelques heures. WhatsApp est le plus rapide.'
      assign l_wa = 'Écrire sur WhatsApp'
      assign l_mail = 'Envoyer un e-mail'
      assign l_chap = 'Sur cette page'
      assign q1 = 'Livraison en Égypte'
      assign a1 = 'Le Caire et Gizeh 85 · Alexandrie 120 · reste de l’Égypte 150 EGP (2–5 jours). Express au Caire et à Gizeh uniquement'
      assign q2 = 'Livraison gratuite'
      assign a2 = 'Au-delà de 2 999 EGP · Valable au Caire et à Gizeh'
      assign q3 = 'International'
      assign a3 = '1 200 EGP jusqu’à 4 000 EGP de commande · 3 200 EGP au-delà'
      assign q4 = 'Échanges'
      assign a4 = 'Pièces non portées, sous 2 jours après réception'
      assign q5 = 'Paiement'
      assign a5 = 'À la livraison ou par carte'
    when 'nl'
      assign l_search = 'Zoek een vraag…'
      assign l_none = 'Geen vraag gevonden. Stuur ons een WhatsApp, we antwoorden snel.'
      assign l_quick = 'Snelle antwoorden'
      assign l_more = 'Alle vragen'
      assign l_still = 'Nog een vraag?'
      assign l_still_t = 'We antwoorden meestal binnen een paar uur. WhatsApp is het snelst.'
      assign l_wa = 'Stuur een WhatsApp'
      assign l_mail = 'Stuur een e-mail'
      assign l_chap = 'Op deze pagina'
      assign q1 = 'Bezorging in Egypte'
      assign a1 = 'Caïro en Gizeh 85 · Alexandrië 120 · rest van Egypte 150 EGP (2–5 dagen). Express alleen in Caïro en Gizeh'
      assign q2 = 'Gratis bezorging'
      assign a2 = 'Boven 2.999 EGP · Geldt voor Caïro en Gizeh'
      assign q3 = 'Wereldwijd'
      assign a3 = '1.200 EGP tot 4.000 EGP bestelling · 3.200 EGP daarboven'
      assign q4 = 'Ruilen'
      assign a4 = 'Ongedragen stukken, binnen 2 dagen na levering'
