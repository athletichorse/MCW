{%- if template.name == 'page' and page.handle == 'faqs' and page.content != blank -%}
{%- liquid
  assign mim_body = page.content | replace: '<p class="tt-title">', '§Q§' | replace: '<h6 class="tt-title">', '§Q§' | replace: '<h3>', '§Q§' | replace: '<h6>', '§Q§'
  assign mim_parts = mim_body | split: '§Q§'
  assign mim_q = ''
  assign mim_a = ''
  assign mim_faq = ''
  for part in mim_parts
    if forloop.first
      continue
    endif
    assign head = part | split: '</' | first
    assign q = head | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | strip
    assign a_raw = part | remove_first: head
    assign a = a_raw | replace: '<', ' <' | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | strip_newlines | strip
    if q != blank
      if mim_q != blank and mim_a != blank
        assign mim_faq = mim_faq | append: '{"@type":"Question","name":' | append: mim_q | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: mim_a_json | append: '}},'
      endif
      assign mim_q = q | json
      assign mim_a = a
    else
      assign mim_a = mim_a | append: ' ' | append: a | strip
    endif
    assign mim_a_json = mim_a | json
  endfor
  if mim_q != blank and mim_a != blank
    assign mim_faq = mim_faq | append: '{"@type":"Question","name":' | append: mim_q | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: mim_a_json | append: '}},'
  endif
  assign mim_faq = mim_faq | remove_last: ','
-%}
{%- if mim_faq != blank -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ mim_faq }}]}
</script>
{%- endif -%}
{%- endif -%}
