</style>
<script>
(function(){
var root=document.querySelector('[data-msg]');if(!root)return;
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
/* chart = the finder model's own body chart (assets/mim-size-finder.js CHART) */
var SIZES=['XS','S','M','L','XL','XXL','3XL','4XL'],BUST=[82,86,91,97,103,109,115,121],WAIST=[64,68,73,79,85,91,97,103],HIPS=[90,94,99,105,111,117,123,129],REL=['','1','1','2','2','3','3','4'];
var ALIAS={XXXL:'3XL','2XL':'XXL',XXXXL:'4XL'};
var tbody=root.querySelector('[data-msg-rows]'),table=root.querySelector('.msg-table'),unit='cm',yours=null,youTxt={{ t_yours | json }};
function n(v){return unit==='cm'?v:(v/2.54).toFixed(1).replace(/\.0$/,'');}
function rows(){tbody.innerHTML=SIZES.map(function(s,i){return '<tr data-size="'+s+'"'+(s===yours?' class="is-you"':'')+'><td'+(s===yours?' data-you="'+youTxt+'"':'')+'>'+s+'</td><td><span class="msg-num">'+n(BUST[i])+'</span></td><td><span class="msg-num">'+n(WAIST[i])+'</span></td><td><span class="msg-num">'+n(HIPS[i])+'</span></td><td>'+(REL[i]||'–')+'</td></tr>';}).join('');}
rows();
root.querySelectorAll('[data-u]').forEach(function(b){b.addEventListener('click',function(){if(unit===b.dataset.u)return;unit=b.dataset.u;root.querySelectorAll('[data-u]').forEach(function(x){x.classList.toggle('is-on',x===b);});
  if(reduce){rows();return;}table.classList.add('is-swap');setTimeout(function(){rows();table.classList.remove('is-swap');},220);});});
/* the finder tells us the size (on load when a profile is saved, and after each run) */
document.addEventListener('mim:size',function(e){var v=String(e.detail.value||'').toUpperCase();yours=ALIAS[v]||v;rows();});
/* garment tabs drive the model */
var tabs=root.querySelectorAll('[data-g]');
tabs.forEach(function(b){b.addEventListener('click',function(){tabs.forEach(function(x){x.classList.toggle('is-on',x===b);x.setAttribute('aria-selected',x===b?'true':'false');});
  var f=document.getElementById('MimSfPage');if(!f)return;f.dataset.garment=b.dataset.g;if(f.setGarment)f.setGarment(b.dataset.g);});});
/* measuring steps <-> figure lines */
var steps=root.querySelectorAll('.msg-steps li'),lines=root.querySelectorAll('.msg-line'),cur=1,timer;
function show(i){cur=i;steps.forEach(function(li){li.classList.toggle('is-on',+li.dataset.step===i);});lines.forEach(function(l){l.classList.remove('is-on');if(+l.dataset.line===i){void l.getBoundingClientRect();l.classList.add('is-on');}});}
steps.forEach(function(li){li.querySelector('button').addEventListener('click',function(){clearInterval(timer);show(+li.dataset.step);});});
show(1);
/* reveal + gentle auto-play of the steps while visible */
if(!reduce&&'IntersectionObserver' in window){root.classList.add('msg-js');
  var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px'});
  root.querySelectorAll('.msg-rv').forEach(function(el){io.observe(el);});
  var how=root.querySelector('.msg-how');var playing=false;
  new IntersectionObserver(function(en){var vis=en[0].isIntersecting;if(vis&&!playing){playing=true;timer=setInterval(function(){show(cur%4+1);},3800);}else if(!vis&&playing){playing=false;clearInterval(timer);}},{threshold:.4}).observe(how);
}
})();
</script>
