<div class="msg" data-msg>
<header class="msg-hero">
<div class="page-width msg-hero__in">
<p class="msg-eyebrow">{{ t_eyebrow }}</p>
<h1 class="msg-title">{{ page.title | escape }}</h1>
<p class="msg-lead">{{ t_lead }}</p>
</div>
</header>

<section class="page-width msg-finder">
<div class="msg-card">
<p class="msg-label">{{ t_for }}</p>
<div class="msg-tabs" role="tablist">
<button type="button" role="tab" class="is-on" aria-selected="true" data-g="dress"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l-1 5 5 13H5l5-13z"/></svg>{{ t_dress }}</button>
<button type="button" role="tab" aria-selected="false" data-g="top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l-5 3 2 5 3-1v11h8V10l3 1 2-5-5-3c-1 2-2.5 3-4 3S9 5 8 3z"/></svg>{{ t_top }}</button>
<button type="button" role="tab" aria-selected="false" data-g="bottom"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l1 18h-5l-2-11-2 11H5z"/></svg>{{ t_pants }}</button>
</div>
{% render 'mim-size-finder-core', page_mode: true, garment_in: 'dress' %}
</div>
</section>

<section class="page-width msg-sec msg-rv" aria-labelledby="MsgChart">
<div class="msg-sec__head">
<div>
<h2 id="MsgChart" class="msg-h">{{ t_chart }}</h2>
<p class="msg-sub">{{ t_chart_sub }}</p>
</div>
<div class="msg-units" role="group"><button type="button" class="is-on" data-u="cm">{{ l_cm }}</button><button type="button" data-u="in">in</button></div>
</div>
<div class="msg-table-wrap">
<table class="msg-table">
<thead><tr><th scope="col">{{ t_size }}</th><th scope="col">{{ 'mim.sf.bust' | t }}</th><th scope="col">{{ 'mim.sf.waist' | t }}</th><th scope="col">{{ 'mim.sf.hips' | t }}</th><th scope="col">{{ t_relaxed }}</th></tr></thead>
<tbody data-msg-rows></tbody>
</table>
</div>
<p class="msg-note">{{ t_relaxed_note }}</p>
</section>

<section class="page-width msg-sec msg-rv" aria-labelledby="MsgHow">
<h2 id="MsgHow" class="msg-h">{{ t_how }}</h2>
<p class="msg-sub">{{ t_how_sub }}</p>
<div class="msg-how">
<div class="msg-fig" aria-hidden="true">
<svg viewBox="0 0 120 300">
<g class="msg-body"><circle cx="60" cy="26" r="15"/><rect x="54" y="39" width="12" height="13" rx="4"/><path d="M42 50h36c7 0 12 5 14 12l9 40c2 6-6 8-7 2l-9-33-2 23c11 16 16 36 16 57H86l-6 140H68l-6-104-6 104H44l-6-140H25c0-21 5-41 16-57l-2-23-9 33c-1 6-9 4-7-2l9-40c2-7 7-12 14-12z"/></g>
<g class="msg-line" data-line="1"><ellipse cx="60" cy="80" rx="27" ry="5"/></g>
<g class="msg-line" data-line="2"><ellipse cx="60" cy="112" rx="21" ry="4.5"/></g>
<g class="msg-line" data-line="3"><ellipse cx="60" cy="148" rx="30" ry="5.5"/></g>
<g class="msg-line" data-line="4"><path d="M60 47 L80 54 L100 108"/></g>
</svg>
</div>
<ol class="msg-steps">
<li class="is-on" data-step="1"><button type="button"><i>1</i><b>{{ s1 }}</b></button><p>{{ d1 }}</p></li>
<li data-step="2"><button type="button"><i>2</i><b>{{ s2 }}</b></button><p>{{ d2 }}</p></li>
<li data-step="3"><button type="button"><i>3</i><b>{{ s3 }}</b></button><p>{{ d3 }}</p></li>
<li data-step="4"><button type="button"><i>4</i><b>{{ s4 }}</b></button><p>{{ d4 }}</p></li>
</ol>
</div>
</section>

<section class="page-width msg-sec msg-rv">
<div class="msg-help">
<div><b>{{ t_help }}</b><span>{{ t_help_d }}</span></div>
<p><a class="msg-btn msg-btn--wa" href="https://wa.me/201222116237" target="_blank" rel="noopener">{{ t_wa }}</a><a class="msg-btn msg-btn--ghost" href="{{ routes.all_products_collection_url }}">{{ t_shop }}</a></p>
</div>
{%- if page.content != blank -%}
<details class="msg-sheet"><summary>{{ t_sheet }}</summary><div class="rte">{{ page.content }}</div></details>
{%- endif -%}
</section>
</div>
